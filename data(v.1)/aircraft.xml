    <!--
      - Identifies the engine design.
      - Use this when researching engine-specific limits.
    -->
    <engine_type>Twin Lycoming T-53 turboshaft engines</engine_type>
    <!--
      - Number of blades on each rotor.
      - Part of the rotor's physical geometry.
    -->
