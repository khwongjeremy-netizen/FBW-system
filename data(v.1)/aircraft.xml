    <!--
      - Width of one rotor from tip to tip.
      - Used to determine rotor-disc size.
    -->
    <rotor_diameter unit="ft">25</rotor_diameter>
    <!--
      - Reported time to change flight configuration.
      - Describes the transition between hover and airplane modes.
