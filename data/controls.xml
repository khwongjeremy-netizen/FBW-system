<?xml version='1.0' encoding='utf-8'?>
<xv15_dataset aircraft="XV-15" dataset_version="1.0">
  <!--
      - Groups movable aerodynamic surfaces and their limits.
      - These surfaces help change aircraft attitude and direction.
    -->
  <control_surfaces source="S2">
    <!--
      - High-lift surface that changes wing lift and drag.
    -->
    <flap location="p. 14, sec. 3.4">
      <!--
      - Total area of the named surface.
      - Check whether the source counts one surface or both.
    -->
      <total_area unit="ft^2" definition="area aft of hinge, both panels">11.0</total_area>
    </flap>
    <!--
      - Combines flap and aileron functions.
      - Can contribute to lift and roll control.
    -->
    <flaperon location="p. 14, sec. 3.4">
      <!--
      - Total area of the named surface.
      - Check whether the source counts one surface or both.
    -->
      <total_area unit="ft^2" definition="area aft of hinge, both panels">20.2</total_area>
      <!--
      - Reported upward deflection limit for roll control.
      - Confirm the source's sign convention.
    -->
      <roll_travel_up unit="deg">23.8</roll_travel_up>
      <!--
      - Reported downward deflection limit for roll control.
      - Confirm the source's sign convention.
    -->
      <roll_travel_down unit="deg">13.8</roll_travel_down>
      <!--
      - Short context or limitation notes.
      - Comments do not change the recorded source value.
    -->
      <comment>- NotebookLM describes these as limits during conversion; confirm the exact sign convention in the figure.</comment>
    </flaperon>
    <!--
      - Movable tail surface used mainly for pitch control.
    -->
    <elevator location="p. 14, sec. 3.4">
      <!--
      - Total area of the named surface.
      - Check whether the source counts one surface or both.
    -->
      <total_area unit="ft^2" definition="area aft of hinge">13.0</total_area>
      <!--
      - Reported movement or deflection range.
      - The unit attribute gives the measurement unit.
    -->
      <travel unit="deg">±20</travel>
    </elevator>
    <!--
      - Movable vertical-tail surface used mainly for yaw control.
    -->
    <rudder location="p. 14, sec. 3.4">
      <!--
      - Total area of the named surface.
      - Check whether the source counts one surface or both.
    -->
      <total_area unit="ft^2" definition="area aft of hinge, total">7.5</total_area>
      <!--
      - Reported movement or deflection range.
      - The unit attribute gives the measurement unit.
    -->
      <travel unit="deg">±20</travel>
    </rudder>
    <!--
      - Groups physical travel ranges for pilot controls.
      - These are input movements, not aircraft response values.
    -->
    <pilot_controls source="S2" location="table 8.3.1, p. 61">
      <!--
      - Forward/backward movement of the control stick.
      - Commonly associated with pitch commands.
    -->
      <stick_fore_aft_travel unit="in">±4.8</stick_fore_aft_travel>
      <!--
      - Side-to-side movement of the control stick.
      - Commonly associated with roll commands.
    -->
      <stick_lateral_travel unit="in">±4.8</stick_lateral_travel>
      <!--
      - Physical travel of the collective/power lever.
      - Do not confuse travel distance with engine power.
    -->
      <collective_power_lever_travel unit="in">10.0</collective_power_lever_travel>
      <!--
      - Foot-pedal movement range.
      - Commonly associated with yaw commands.
    -->
      <pedal_travel unit="in">±2.5</pedal_travel>
    </pilot_controls>
  </control_surfaces>
</xv15_dataset>